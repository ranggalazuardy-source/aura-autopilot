{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-autopilot-api",
  "main": "cloudflare/worker.py",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./virtual-office/dist",
    "base_path": "/office",
    "run_worker_first": ["/office/state*"],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura-autopilot-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
