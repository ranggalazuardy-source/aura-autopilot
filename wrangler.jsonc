{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-autopilot-api",
  "main": "cloudflare/worker.py",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "vars": {
    "AURA_SCHEDULER_ENABLED": "false",
    "AURA_MODEL_ENABLED": "false",
    "AURA_GROQ_ENABLED": "false",
    "AURA_CLOUDFLARE_FREE_PLAN_CONFIRMED": "false"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": "./virtual-office/dist",
    "base_path": "/office",
    "run_worker_first": [
      "/office/state*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura-autopilot-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "AURA_AUTH_RATE_LIMITER",
      "namespace_id": "204382026",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "ai": {
    "binding": "AI"
  }
}
